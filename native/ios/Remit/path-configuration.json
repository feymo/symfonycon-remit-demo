{
    "rules": [
        {
            "patterns": [
                ".*"
            ],
            "properties": {
                "context": "default",
                "pull_to_refresh_enabled": true
            }
        },
        {
            "patterns": [
                "/archives$"
            ],
            "properties": {
                "context": "modal",
                "pull_to_refresh_enabled": false
            }
        }
    ]
}
