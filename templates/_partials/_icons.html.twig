{#
    Inline stroke icons. Usage:
        {% import '_partials/_icons.html.twig' as icons %}
        {{ icons.icon('plane', 24) }}
    Category icons are stored on Category::$icon (plane, bed, car, utensils, cup, box).
#}
{% macro icon(name, size = 24, stroke = 2) %}
