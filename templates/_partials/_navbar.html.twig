{% import '_partials/_icons.html.twig' as icons %}
{% set route = app.request.attributes.get('_route') %}
<header class="navbar">
    <a class="navbar__brand" href="{{ path('app_expense_index') }}">
        <span class="navbar__mark">{{ icons.icon('receipt', 20, 2.2) }}</span>
        <span>Remit</span>
    </a>
    <nav class="navbar__links" aria-label="Main">
        <a href="{{ path('app_expense_index') }}"{% if route starts with 'app_expense' %} aria-current="page"{% endif %}>Expenses</a>
        <a href="{{ path('app_category_recap') }}"{% if route == 'app_category_recap' %} aria-current="page"{% endif %}>By category</a>
        <a href="{{ path('app_archive_index') }}"{% if route == 'app_archive_index' %} aria-current="page"{% endif %}>Archives</a>
    </nav>
</header>
